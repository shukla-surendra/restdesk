{
  "name": "restdesk-desktop",
  "productName": "RestDesk",
  "version": "0.3.0",
  "description": "RestDesk desktop app: lightweight local REST client",
  "license": "MIT",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "node scripts/smoke.mjs",
    "build:server": "node scripts/build-server.mjs",
    "dist": "npm run build:server && electron-builder",
    "dist:dir": "npm run build:server && electron-builder --dir",
    "icons": "electron scripts/render-icon.cjs"
  },
  "build": {
    "appId": "io.github.restdesk",
    "productName": "RestDesk",
    "files": [
      "main.js",
      "package.json",
      "resources/icon.png"
    ],
    "extraResources": [
      {
        "from": "build/server-dist/restdesk-server",
        "to": "server"
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    },
    "icon": "resources/icon.png"
  },
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0"
  }
}
